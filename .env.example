APP_NAME="SDAYA Cartas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_BO
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sdaya_cartas
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer
RUN_MIGRATIONS=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

SDAYA_DOCUMENTOS_DISK=local
SDAYA_DOCUMENTOS_PATH=documentos

MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="sistema@sdaya.com.bo"
MAIL_FROM_NAME="${APP_NAME}"

# Solo se usan al ejecutar php artisan db:seed.
# Cambia estos valores antes de instalar en un entorno real.
ADMIN_NAME="Administrador SDAYA"
ADMIN_EMAIL=admin@sdaya.local
ADMIN_PASSWORD="8uVHbb49j18B"

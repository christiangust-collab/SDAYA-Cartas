APP_NAME="SDAYA Cartas"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://cartas.ejemplo.com
APP_DOMAIN=cartas.ejemplo.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_BO
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=sdaya_cartas
DB_USERNAME=sdaya
DB_PASSWORD="CAMBIAR_POR_UNA_CLAVE_LARGA_Y_UNICA"
DB_SSLMODE=prefer
RUN_MIGRATIONS=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

SDAYA_DOCUMENTOS_DISK=local
SDAYA_DOCUMENTOS_PATH=documentos

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.ejemplo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="sistema@sdaya.com.bo"
MAIL_FROM_NAME="SDAYA Cartas"

# Se usan en la primera carga de datos. No conserves esta contraseña temporal.
ADMIN_NAME="Administrador SDAYA"
ADMIN_EMAIL=administrador@ejemplo.com
ADMIN_PASSWORD="CAMBIAR_POR_UNA_CLAVE_ADMINISTRATIVA_UNICA"
